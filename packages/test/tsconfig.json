{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "jsx": "react",
    "lib": ["ES2023", "DOM"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "sourceMap": true,
    "strict": false,
    "target": "ES2023",
    "types": ["jest", "node"],
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"],
}
